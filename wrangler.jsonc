{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "cotizador-sirius",
    "main": "worker.mjs",
    "account_id": "1c724d9588b48bc0b7361c1d08077ebc",
    "compatibility_date": "2026-10-06",
    "workers_dev": true,
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
    },
    "observability": {
        "enabled": true,
        "traces": {
            "enabled": true
        }
    }
}
